<Window x:Class="CpuTempWidget.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CpuTempWidget.Controls"
        Title="About Pulse"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1220"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
  <Border x:Name="RootBorder" Padding="28" BorderBrush="#2A4060" BorderThickness="1">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <controls:PulseMark x:Name="LogoMark" Width="48" Height="28" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ProductTitle"
                     Text="Pulse"
                     FontFamily="Segoe UI Variable Display, Segoe UI"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF" />
          <TextBlock Text="by MugoByte Technologies"
                     FontFamily="Segoe UI Variable Small, Segoe UI"
                     FontSize="11"
                     Foreground="#94A3B8" />
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="VersionText"
                 FontFamily="Segoe UI Variable Small, Segoe UI"
                 FontSize="12"
                 Foreground="#38BDF8"
                 Margin="0,0,0,12" />

      <TextBlock x:Name="TaglineText"
                 FontFamily="Segoe UI Variable Small, Segoe UI"
                 FontSize="13"
                 Foreground="#B4C2D6"
                 TextWrapping="Wrap"
                 Margin="0,0,0,20" />

      <TextBlock FontFamily="Segoe UI Variable Small, Segoe UI"
                 FontSize="12"
                 Foreground="#94A3B8"
                 TextWrapping="Wrap"
                 Margin="0,0,0,24"
                 Text="CPU · Temperature · Memory · Battery&#x0a;Right-click anywhere on Pulse for controls." />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="WebsiteButton"
                Content="mugobyte.com"
                Padding="16,8"
                Margin="0,0,10,0"
                Background="#16213A"
                Foreground="#38BDF8"
                BorderBrush="#2A4060"
                BorderThickness="1"
                Click="WebsiteButton_Click" />
        <Button Content="Close"
                Padding="20,8"
                Background="#1E81C1"
                Foreground="#FFFFFF"
                FontWeight="SemiBold"
                BorderThickness="0"
                Click="CloseButton_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
