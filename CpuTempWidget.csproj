<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Brand\pulse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>CpuTempWidget</RootNamespace>
    <Version>1.12.3</Version>
    <Description>Pulse — production Windows command center by MugoByte Technologies</Description>
    <Copyright>Copyright © MugoByte Technologies</Copyright>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WinForms available for NotifyIcon only; do not pollute global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <!-- Optional CPU package sensors; soft-loaded at runtime if restore succeeds. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" Condition="'$(PulseDisableLhm)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="MugoByte.Platform\MugoByte.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Nested class library must not be double-compiled into the WPF app. -->
    <Compile Remove="MugoByte.Platform\**\*" />
    <None Remove="MugoByte.Platform\**\*" />
    <EmbeddedResource Remove="MugoByte.Platform\**\*" />
    <Page Remove="MugoByte.Platform\**\*" />
    <Compile Remove="_platform_smoke\**\*" />
    <None Remove="_platform_smoke\**\*" />
    <Compile Remove="Pulse.Tests\**\*" />
    <None Remove="Pulse.Tests\**\*" />
    <Compile Remove="TWINK\**\*" />
    <None Remove="TWINK\**\*" />
    <EmbeddedResource Remove="TWINK\**\*" />
    <Page Remove="TWINK\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\**\*" />
    <Content Include="Assets\Brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
