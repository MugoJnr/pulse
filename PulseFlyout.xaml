<UserControl x:Class="CpuTempWidget.PulseFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CpuTempWidget.Controls"
             MinWidth="248">
  <UserControl.Resources>
    <Style x:Key="MenuButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border x:Name="ShadowBorder" Padding="2" CornerRadius="14" Background="Transparent">
    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderThickness="1"
            Padding="12,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="2,0,2,10">
          <controls:PulseMark x:Name="PulseLogo" Width="38" Height="22" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProductTitle"
                       Text="Pulse"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="CompanyLine"
                       Text="by MugoByte Technologies"
                       FontFamily="Segoe UI Variable Small, Segoe UI"
                       FontSize="10.5"
                       Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="VersionLine"
                   FontFamily="Segoe UI Variable Small, Segoe UI"
                   FontSize="10"
                   Margin="2,0,2,8"
                   Text="" />

        <Border x:Name="TopSeparator" Height="1" Margin="0,0,0,6" />

        <Button x:Name="OpenButton" Style="{StaticResource MenuButtonStyle}" Click="OpenButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="OpenIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14" Width="22" />
            <TextBlock x:Name="OpenLabel" Text="Open Pulse" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button x:Name="LaunchButton" Style="{StaticResource MenuButtonStyle}" Click="LaunchButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LaunchIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" Width="22" />
            <TextBlock x:Name="LaunchLabel" Text="Launch at startup" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button x:Name="LockButton" Style="{StaticResource MenuButtonStyle}" Click="LockButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LockIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE785;" FontSize="14" Width="22" />
            <TextBlock x:Name="LockLabel" Text="Lock position" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>

        <Border x:Name="MidSeparator" Height="1" Margin="0,6" />

        <Button x:Name="RestartButton" Style="{StaticResource MenuButtonStyle}" Click="RestartButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="RestartIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" Width="22" />
            <TextBlock x:Name="RestartLabel" Text="Restart Pulse" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource MenuButtonStyle}" Click="CloseButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CloseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14" Width="22" />
            <TextBlock x:Name="CloseLabel" Text="Close Pulse" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>

        <Border x:Name="BottomSeparator" Height="1" Margin="0,6" />

        <Button x:Name="RestartPcButton" Style="{StaticResource MenuButtonStyle}" Click="RestartPcButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="RestartPcIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE777;" FontSize="14" Width="22" />
            <TextBlock x:Name="RestartPcLabel" Text="Restart PC" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button x:Name="ShutdownButton" Style="{StaticResource MenuButtonStyle}" Click="ShutdownButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ShutdownIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="14" Width="22" />
            <TextBlock x:Name="ShutdownLabel" Text="Shut down PC" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
        <Button x:Name="AboutButton" Style="{StaticResource MenuButtonStyle}" Click="AboutButton_Click" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="AboutIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" Width="22" />
            <TextBlock x:Name="AboutLabel" Text="About Pulse" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="12.5" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
